<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections, which is how this app reaches the backend.
	     Needed in release as well as debug: the shipped app talks to the same
	     API, and without this the sandbox reports the server as unreachable
	     while it is running perfectly well. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Without this the sandbox redirects a saved receipt into the app's
	     private container instead of the user's real ~/Downloads. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
