<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections, which is how this app reaches the backend.
	     Needed in release as well as debug: the shipped app talks to the same
	     API, and without this the sandbox reports the server as unreachable
	     while it is running perfectly well. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Without this the sandbox redirects a saved receipt into the app's
	     private container instead of the user's real ~/Downloads. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- The open panel used to pick a product photo, and the Save As dialog
	     used to export reports to a folder the user chooses (DocumentSaver,
	     ReceiptSaver). Without this the sandbox blocks both panels from
	     appearing at all: the button reacts to the tap and nothing else
	     happens, which reads as a dead control rather than as a permission
	     the app was never granted. Read-write, not read-only, because the
	     export panel has to write the chosen file, not just read one. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
