<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Outgoing connections, which is how this app reaches the backend. The
	     `network.server` key above is the opposite direction and is there for
	     Flutter's own debug tooling, so its presence is not a substitute:
	     without this one the sandbox refuses every request before it leaves
	     the process, and the app reports the server as unreachable while the
	     server is running perfectly well. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Without this the sandbox redirects a saved receipt into the app's
	     private container instead of the user's real ~/Downloads. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- The open panel used to pick a product photo, and the Save As dialog
	     used to export reports to a folder the user chooses (DocumentSaver,
	     ReceiptSaver). Without this the sandbox blocks both panels from
	     appearing at all: the button reacts to the tap and nothing else
	     happens, which reads as a dead control rather than as a permission
	     the app was never granted. Read-write, not read-only, because the
	     export panel has to write the chosen file, not just read one. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
